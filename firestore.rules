rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Champions can be picked or changed through the end of July 4, 2026
    // (2026-07-05 06:00 UTC = 23:59 July 4 in UTC-6).
    function championDeadline() {
      return timestamp.date(2026, 7, 5) + duration.value(6, 'h');
    }

    // A match is open for predictions only while it is still 'upcoming'
    // and kickoff has not yet passed.
    function matchOpen(matchId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return m.status == 'upcoming' && m.kickoffTime > request.time;
    }

    // True when the requesting user is a member of the given group. Predictions
    // and champion picks are scoped per group, so only members may write them.
    function isGroupMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // Diff helper: the set of fields changed by this write.
    function changed(resourceData) {
      return request.resource.data.diff(resourceData).affectedKeys();
    }

    // A prediction score must be an integer goal count in [0, 99]. Mirrors the
    // client-side Zod check in src/lib/form-schemas.ts — enforced here so the
    // range is authoritative and can't be bypassed via the SDK.
    function validScore(s) {
      return s is int && s >= 0 && s <= 99;
    }

    // Global, admin-configurable cap on members per group. Falls back to 100
    // when the /config/app doc has not been created yet. Kept in sync with
    // DEFAULT_MAX_MEMBERS_PER_GROUP in src/lib/config.ts.
    function maxMembersPerGroup() {
      return exists(/databases/$(database)/documents/config/app)
        ? get(/databases/$(database)/documents/config/app).data.get('maxMembersPerGroup', 100)
        : 100;
    }

    // ---- Sign-up gate helper ----
    // A new profile may only be created by consuming a valid invite from
    // /invites (admin-minted app invites and user-minted group invites both
    // live here). The invite doc must be active, unexpired, under its cap, not
    // already used by this user, AND be bumped by exactly one use + this uid in
    // the SAME atomic write (getAfter ties the two writes together).
    function consumeOk(code) {
      let before = get(/databases/$(database)/documents/invites/$(code)).data;
      let after = getAfter(/databases/$(database)/documents/invites/$(code)).data;
      return before.active == true
        && (before.expiresAt == null || before.expiresAt > request.time)
        && before.uses < before.maxUses
        && !(request.auth.uid in before.consumedBy)
        && after.uses == before.uses + 1
        && after.consumedBy == before.consumedBy.concat([request.auth.uid]);
    }

    function validInvite(code) {
      return code != ''
        && exists(/databases/$(database)/documents/invites/$(code))
        && consumeOk(code);
    }

    // ---- Users ----
    match /users/{userId} {
      // Any signed-in user can read profiles (needed for leaderboards).
      allow read: if isSignedIn();

      // On sign-up a user creates only their own doc, may never self-grant
      // admin, and must consume a valid /invites code in the same atomic write
      // — this is the invite-only gate.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.isAdmin == false
        && validInvite(request.resource.data.get('inviteId', ''));

      // Admins may update any profile (e.g. recomputed totalPoints/exactGuesses).
      // A user may update only their own whitelisted profile fields — never
      // isAdmin, email, totalPoints or exactGuesses — and may only change their
      // champion pick before the deadline.
      allow update: if isAdmin() || (
        request.auth.uid == userId
        && changed(resource.data).hasOnly(['displayName', 'city', 'neighborhood', 'age', 'champion', 'fcmTokens'])
        && (!changed(resource.data).hasAny(['champion']) || request.time < championDeadline())
      );

      // Only admins delete profiles.
      allow delete: if isAdmin();

      // ---- Notifications (per-user subcollection) ----
      match /notifications/{notifId} {
        // Owner reads their own; admins read all.
        allow read: if request.auth.uid == userId || isAdmin();
        // Only admins create notifications (e.g. score-update fan-out).
        allow create: if isAdmin();
        // Owner may only flip the read flag; admins may do anything.
        allow update: if isAdmin() || (
          request.auth.uid == userId && changed(resource.data).hasOnly(['read'])
        );
        allow delete: if request.auth.uid == userId || isAdmin();
      }
    }

    // ---- Matches ----
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- Predictions ----
    match /predictions/{predictionId} {
      // Any signed-in user can read predictions (needed for leaderboards).
      allow read: if isSignedIn();

      // Users create predictions only for themselves, scoped to a group they
      // belong to, only while the match is open, and may never set their points.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.pointsEarned == null
        && validScore(request.resource.data.predictedHomeScore)
        && validScore(request.resource.data.predictedAwayScore)
        && isGroupMember(request.resource.data.groupId)
        && matchOpen(request.resource.data.matchId);

      // Users may edit their own prediction only while the match is still open,
      // and may not change ownership, the group, the match, or the points.
      // Admins (scoring) may write points freely.
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.matchId == resource.data.matchId
        && request.resource.data.pointsEarned == resource.data.pointsEarned
        && validScore(request.resource.data.predictedHomeScore)
        && validScore(request.resource.data.predictedAwayScore)
        && matchOpen(resource.data.matchId)
      );

      allow delete: if isAdmin();
    }

    // ---- Champions (per-group champion pick) ----
    // One pick per (user, group); doc id is `${userId}_${groupId}`. Display-only.
    match /champions/{championId} {
      // Any signed-in user can read (needed for leaderboard display).
      allow read: if isSignedIn();

      // Users write only their own pick, for a group they belong to, and only
      // before the champion deadline.
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isGroupMember(request.resource.data.groupId)
        && request.time < championDeadline();

      allow delete: if isAdmin();
    }

    // ---- Groups ----
    match /groups/{groupId} {
      // Only members (and admins) can read a group.
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.members || isAdmin()
      );

      // Creator sets themselves as the sole initial member.
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      // Update is allowed when:
      //  - a user adds only themselves to members (joining via invite link),
      //    and the group stays within the global member cap, or
      //  - the creator edits the group, or
      //  - an admin edits the group.
      allow update: if isSignedIn() && (
        (
          changed(resource.data).hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.hasOnly(resource.data.members.concat([request.auth.uid]))
          && request.resource.data.members.size() <= maxMembersPerGroup()
        )
        || resource.data.creatorId == request.auth.uid
        || isAdmin()
      );

      allow delete: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid || isAdmin()
      );
    }

    // ---- Invites (sign-up gate + group join links) ----
    // Capped, optionally-expiring links that let a new user create a profile.
    // Admins mint generic 'app' invites; group creators mint 'group' invites
    // tied to their group. Doc id is the code.
    match /invites/{code} {
      // Links are capability URLs (unguessable); allow lookup so the sign-up
      // page can validate the link before the user has authenticated.
      allow read: if true;

      // Admins mint any invite. A signed-in user may mint a 'group' invite for
      // themselves, with a fresh use count and the global cap as maxUses (so
      // users can't pick their own cap).
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.type == 'group'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.uses == 0
        && request.resource.data.consumedBy == []
        && request.resource.data.maxUses == maxMembersPerGroup()
      );

      // Admins or the invite's creator may revoke it.
      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.createdBy == request.auth.uid
      );

      // Admins may edit freely (toggle active, raise the cap, change expiry).
      // A signing-up user may only "consume" the invite: bump uses by exactly
      // one and append their own uid — and only while active, unexpired and
      // under the cap.
      allow update: if isAdmin() || (
        isSignedIn()
        && changed(resource.data).hasOnly(['uses', 'consumedBy'])
        && resource.data.active == true
        && (resource.data.expiresAt == null || resource.data.expiresAt > request.time)
        && resource.data.uses < resource.data.maxUses
        && !(request.auth.uid in resource.data.consumedBy)
        && request.resource.data.uses == resource.data.uses + 1
        && request.resource.data.consumedBy == resource.data.consumedBy.concat([request.auth.uid])
      );
    }

    // ---- Global app config ----
    // Single doc /config/app holding admin-only settings (e.g. the group member
    // cap). Publicly readable so the sign-up page and rules can use it.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
